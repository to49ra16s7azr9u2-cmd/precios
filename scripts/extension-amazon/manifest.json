{
  "manifest_version": 3,
  "name": "ComparaMEX · captura de Amazon",
  "description": "Saca los productos de cualquier listado de amazon.com.mx (búsqueda, departamento, más vendidos) al JSON de ComparaMEX, y recorre departamentos enteros solo.",
  "version": "2.0",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://www.amazon.com.mx/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.amazon.com.mx/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Captura de Amazon → ComparaMEX" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
